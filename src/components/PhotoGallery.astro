---
interface Props {
  images: string[];
  title: string;
}
const { images, title } = Astro.props;
if (!images || images.length === 0) return;

// Small, optimized thumbnails via Netlify Image CDN. The lightbox still loads
// the full-resolution original (passed to the script below) for zoomed viewing.
function thumb(src: string, w = 640) {
  if (!src.startsWith('/') || src.startsWith('//') || !import.meta.env.PROD) return src;
  const params = new URLSearchParams({ url: src, w: String(w), q: '74', fm: 'avif' });
  return `/.netlify/images?${params.toString()}`;
}
---

<div class="gallery-section">
  <h3 class="gallery-heading">Photo gallery</h3>
  <div class="gallery-grid">
    {images.map((src, i) => (
      <button
        class="gallery-thumb"
        data-index={i}
        aria-label={`View photo ${i + 1} of ${images.length}`}
      >
        <img
          src={thumb(src, 640)}
          srcset={`${thumb(src, 480)} 480w, ${thumb(src, 640)} 640w, ${thumb(src, 960)} 960w`}
          sizes="(max-width:600px) 50vw, 33vw"
          alt={`${title} — photo ${i + 1}`}
          loading="lazy"
          decoding="async"
          width="600"
          height="400"
        />
        <span class="gallery-overlay" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>
          </svg>
        </span>
      </button>
    ))}
  </div>
</div>

<!-- Lightbox -->
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
  <button class="lb-close" id="lbClose" aria-label="Close">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5">
      <path d="M18 6L6 18M6 6l12 12"/>
    </svg>
  </button>

  <button class="lb-nav lb-prev" id="lbPrev" aria-label="Previous photo">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.5">
      <path d="M15 18l-6-6 6-6"/>
    </svg>
  </button>

  <div class="lb-stage">
    <img class="lb-img" id="lbImg" src="" alt="" />
  </div>

  <button class="lb-nav lb-next" id="lbNext" aria-label="Next photo">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.5">
      <path d="M9 18l6-6-6-6"/>
    </svg>
  </button>

  <div class="lb-counter" id="lbCounter"></div>

  <div class="lb-thumbs" id="lbThumbs">
    {images.map((src, i) => (
      <button class="lb-thumb" data-index={i} aria-label={`Go to photo ${i + 1}`}>
        <img src={thumb(src, 160)} alt="" loading="lazy" width="80" height="54" />
      </button>
    ))}
  </div>
</div>

<style>
  /* ===== GRID ===== */
  .gallery-section {
    margin-top: 2.8rem;
  }
  .gallery-heading {
    font-size: 1.3rem;
    margin-bottom: 1.2rem;
    color: var(--c-ink);
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }
  .gallery-thumb {
    all: unset;
    cursor: zoom-in;
    display: block;
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--c-surface-3);
  }
  .gallery-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s var(--ease);
  }
  .gallery-thumb:hover img {
    transform: scale(1.06);
  }
  .gallery-overlay {
    position: absolute;
    inset: 0;
    background: rgba(12, 42, 82, 0);
    display: grid;
    place-items: center;
    color: #fff;
    opacity: 0;
    transition: all 0.25s var(--ease);
  }
  .gallery-thumb:hover .gallery-overlay {
    background: rgba(12, 42, 82, 0.38);
    opacity: 1;
  }
  @media (max-width: 600px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ===== LIGHTBOX ===== */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(5, 12, 28, 0.97);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    animation: lbFadeIn 0.22s ease both;
  }
  .lightbox[hidden] {
    display: none;
  }
  @keyframes lbFadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  .lb-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(255,255,255,0.12);
    border: none;
    color: #fff;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background 0.2s;
    z-index: 10;
  }
  .lb-close:hover { background: rgba(255,255,255,0.25); }

  .lb-stage {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-height: calc(100vh - 160px);
    padding: 0 4rem;
  }
  .lb-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: var(--radius);
    box-shadow: 0 24px 60px rgba(0,0,0,0.6);
    animation: lbImgIn 0.2s ease both;
  }
  @keyframes lbImgIn {
    from { opacity: 0; transform: scale(0.97); }
    to   { opacity: 1; transform: scale(1); }
  }

  .lb-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255,255,255,0.12);
    border: none;
    color: #fff;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background 0.2s;
    z-index: 10;
  }
  .lb-nav:hover { background: rgba(255,255,255,0.28); }
  .lb-prev { left: 0.75rem; }
  .lb-next { right: 0.75rem; }
  .lb-nav:disabled { opacity: 0.25; cursor: default; }

  .lb-counter {
    color: rgba(255,255,255,0.7);
    font-size: 0.9rem;
    margin: 0.75rem 0 0.5rem;
  }

  .lb-thumbs {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding: 0.25rem 0.5rem 0.5rem;
    max-width: 100%;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.3) transparent;
  }
  .lb-thumb {
    all: unset;
    cursor: pointer;
    flex-shrink: 0;
    width: 72px;
    height: 48px;
    border-radius: 6px;
    overflow: hidden;
    opacity: 0.55;
    border: 2px solid transparent;
    transition: opacity 0.2s, border-color 0.2s;
  }
  .lb-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .lb-thumb:hover { opacity: 0.85; }
  .lb-thumb.is-active {
    opacity: 1;
    border-color: var(--c-sky);
  }

  @media (max-width: 600px) {
    .lb-stage { padding: 0 3rem; }
    .lb-prev { left: 0.25rem; }
    .lb-next { right: 0.25rem; }
    .lb-nav { width: 40px; height: 40px; }
  }
</style>

<script define:vars={{ images }}>
  function initGallery() {
    const lightbox  = document.getElementById('lightbox');
    if (!lightbox || lightbox.dataset.bound) return;
    lightbox.dataset.bound = 'true';

    const lbImg     = document.getElementById('lbImg');
    const lbPrev    = document.getElementById('lbPrev');
    const lbNext    = document.getElementById('lbNext');
    const lbClose   = document.getElementById('lbClose');
    const lbCounter = document.getElementById('lbCounter');
    const lbThumbs  = document.getElementById('lbThumbs');
    const thumbBtns = lbThumbs?.querySelectorAll('.lb-thumb');

    let current = 0;

    function show(index) {
      current = Math.max(0, Math.min(index, images.length - 1));
      lbImg.src = images[current];
      lbImg.alt = `Photo ${current + 1}`;
      lbCounter.textContent = `${current + 1} / ${images.length}`;
      lbPrev.disabled = current === 0;
      lbNext.disabled = current === images.length - 1;
      thumbBtns?.forEach((t, i) => t.classList.toggle('is-active', i === current));
      thumbBtns?.[current]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    }

    function open(index) {
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
      show(index);
      lbClose.focus();
    }

    function close() {
      lightbox.hidden = true;
      document.body.style.overflow = '';
    }

    // Open from grid
    document.querySelectorAll('.gallery-thumb').forEach(btn => {
      btn.addEventListener('click', () => open(Number(btn.dataset.index)));
    });

    // Lightbox controls
    lbClose?.addEventListener('click', close);
    lbPrev?.addEventListener('click', () => show(current - 1));
    lbNext?.addEventListener('click', () => show(current + 1));

    // Thumbnail nav
    thumbBtns?.forEach(t => {
      t.addEventListener('click', () => show(Number(t.dataset.index)));
    });

    // Click backdrop to close
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });

    // Keyboard nav
    document.addEventListener('keydown', (e) => {
      if (lightbox?.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });

    // Touch/swipe support
    let touchStartX = 0;
    lightbox?.addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX; }, { passive: true });
    lightbox?.addEventListener('touchend', e => {
      const diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) show(diff > 0 ? current + 1 : current - 1);
    });

    // Clean up the body scroll-lock before navigating away
    document.addEventListener('astro:before-swap', () => {
      document.body.style.overflow = '';
    });
  }

  initGallery();
  document.addEventListener('astro:after-swap', initGallery);
</script>
