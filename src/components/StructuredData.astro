---
// Emits JSON-LD structured data for rich search results.
// Two modes:
//   - "organization" (default): RealEstateAgent schema for the whole site
//   - "listing": RealEstateListing + Product schema for a property page
import { site, company, contact } from '../data/site';
import type { CollectionEntry } from 'astro:content';

interface Props {
  type?: 'organization' | 'listing' | 'article';
  listing?: CollectionEntry<'listings'>;
  post?: CollectionEntry<'blog'>;
  url?: string;
}

const { type = 'organization', listing, post, url: pageUrl } = Astro.props;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  '@id': `${site.url}/#organization`,
  name: site.name,
  description: site.description,
  url: site.url,
  email: contact.email,
  telephone: `+${contact.phones[0].e164}`,
  areaServed: [
    { '@type': 'Place', name: 'El Nido, Palawan, Philippines' },
    { '@type': 'Place', name: 'Coron, Palawan, Philippines' },
    { '@type': 'Place', name: 'Palawan, Philippines' },
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'El Nido',
    addressRegion: 'Palawan',
    addressCountry: 'PH',
  },
  employee: [
    {
      '@type': 'Person',
      name: company.broker.name,
      jobTitle: company.broker.title,
      identifier: company.broker.license,
    },
    {
      '@type': 'Person',
      name: company.salesperson.name,
      jobTitle: company.salesperson.title,
    },
  ],
  openingHours: 'Mo-Sa 08:00-18:00',
};

// Build a listing schema only when a listing is supplied
function buildListingSchema(l: CollectionEntry<'listings'>) {
  const d = l.data;
  const url = `${site.url}/listings/${d.slug}`;
  const image = new URL(d.heroImage, site.url).href;

  const offer: Record<string, unknown> = {
    '@type': 'Offer',
    availability:
      d.status === 'available'
        ? 'https://schema.org/InStock'
        : d.status === 'reserved'
          ? 'https://schema.org/PreOrder'
          : 'https://schema.org/SoldOut',
    url,
  };
  if (d.price != null) {
    offer.price = d.price;
    offer.priceCurrency = d.currency;
  }

  return {
    '@context': 'https://schema.org',
    '@type': 'RealEstateListing',
    '@id': `${url}/#listing`,
    name: d.title,
    description: d.metaDescription ?? d.shortDescription,
    url,
    image,
    datePosted: new Date().toISOString().split('T')[0],
    offers: offer,
    provider: { '@id': `${site.url}/#organization` },
    ...(d.lotSizeSqm
      ? {
          floorSize: {
            '@type': 'QuantitativeValue',
            value: d.lotSizeSqm,
            unitCode: 'MTK',
          },
        }
      : {}),
    ...(d.bedrooms ? { numberOfBedrooms: d.bedrooms } : {}),
    ...(d.bathrooms ? { numberOfBathroomsTotal: d.bathrooms } : {}),
  };
}

function buildArticleSchema(p: CollectionEntry<'blog'>, url: string) {
  const d = p.data;
  const image = new URL(d.heroImage, site.url).href;
  return {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${url}/#article`,
    headline: d.metaTitle ?? d.title,
    description: d.metaDescription ?? d.description,
    image,
    url,
    datePublished: d.pubDate.toISOString().split('T')[0],
    dateModified: (d.updatedDate ?? d.pubDate).toISOString().split('T')[0],
    author: { '@type': 'Organization', name: d.author, url: site.url },
    publisher: { '@id': `${site.url}/#organization` },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    keywords: d.tags.join(', '),
    articleSection: d.category,
  };
}

const articleBreadcrumb =
  type === 'article' && post && pageUrl
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
          {
            '@type': 'ListItem',
            position: 2,
            name: 'Blog',
            item: `${site.url}/blog`,
          },
          {
            '@type': 'ListItem',
            position: 3,
            name: post.data.title,
            item: pageUrl,
          },
        ],
      }
    : null;

const breadcrumb =
  type === 'listing' && listing
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
          {
            '@type': 'ListItem',
            position: 2,
            name: 'Properties',
            item: `${site.url}/listings`,
          },
          {
            '@type': 'ListItem',
            position: 3,
            name: listing.data.title,
            item: `${site.url}/listings/${listing.data.slug}`,
          },
        ],
      }
    : null;

const schemas =
  type === 'listing' && listing
    ? [buildListingSchema(listing), breadcrumb]
    : type === 'article' && post && pageUrl
      ? [buildArticleSchema(post, pageUrl), articleBreadcrumb]
      : [orgSchema];
---

{
  schemas.filter(Boolean).map((schema) => (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}
    />
  ))
}
