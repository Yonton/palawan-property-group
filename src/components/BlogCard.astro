---
import OptimizedImage from './OptimizedImage.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const d = post.data;

const dateLabel = d.pubDate.toLocaleDateString('en-PH', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a class="bcard reveal" href={`/blog/${post.slug}`}>
  <div class="bcard-media">
    <div class="bcard-img-wrap">
      <OptimizedImage
        src={d.heroImage}
        alt={d.title}
        width={600}
        height={400}
        loading="lazy"
        sizes="(max-width:600px) 100vw, (max-width:980px) 50vw, 33vw"
      />
    </div>
    <span class="bcard-cat">{d.category}</span>
  </div>
  <div class="bcard-body">
    <p class="bcard-meta">{dateLabel}</p>
    <h3 class="bcard-title">{d.title}</h3>
    <p class="bcard-desc">{d.description}</p>
    <span class="bcard-cta">
      Read article
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </span>
  </div>
</a>

<style>
  .bcard {
    display: flex;
    flex-direction: column;
    background: var(--c-surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--c-line);
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
    height: 100%;
  }

  .bcard:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }

  .bcard-media {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--c-surface-3);
  }

  .bcard-img-wrap {
    width: 100%;
    height: 100%;
  }

  .bcard-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s var(--ease);
  }

  .bcard:hover .bcard-media :global(img) {
    transform: scale(1.06);
  }

  .bcard-cat {
    position: absolute;
    inset-block-start: 0.9rem;
    inset-inline-start: 0.9rem;
    background: rgba(255, 255, 255, 0.92);
    color: var(--c-navy);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-pill);
    backdrop-filter: blur(6px);
  }

  .bcard-body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.4rem 1.5rem 1.5rem;
    flex: 1;
  }

  .bcard-meta {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--c-sky-deep);
  }

  .bcard-title {
    font-size: 1.25rem;
    color: var(--c-ink);
    line-height: 1.25;
  }

  .bcard-desc {
    font-size: 0.93rem;
    color: var(--c-muted);
    line-height: 1.6;
  }

  .bcard-cta {
    margin-top: auto;
    padding-top: 0.4rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--c-sky-deep);
    font-weight: 600;
    font-size: 0.9rem;
    transition: gap 0.25s var(--ease);
  }

  .bcard:hover .bcard-cta {
    gap: 0.6rem;
  }
</style>
