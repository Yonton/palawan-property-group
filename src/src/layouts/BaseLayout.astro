---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import StructuredData from '../components/StructuredData.astro';
import { site } from '../data/site';
import { ViewTransitions } from 'astro:transitions';
import type { CollectionEntry } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noHeaderOffset?: boolean;
  preloadImage?: string; // path to eagerly preload (above-fold hero image)
  structuredData?: 'organization' | 'listing';
  listing?: CollectionEntry<'listings'>;
  darkHero?: boolean; // page opens with a full-bleed dark hero behind the header
}

const {
  title,
  description = site.description,
  image = '/images/og-default.jpg',
  noHeaderOffset = false,
  preloadImage,
  structuredData = 'organization',
  listing,
  darkHero = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#13b5ea" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}

    <!-- Open Graph -->
    <meta property="og:type" content={structuredData === 'listing' ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title ?? site.name} />
    <meta property="og:locale" content="en_PH" />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data (JSON-LD) for rich search results -->
    <StructuredData type={structuredData} listing={listing} />

    <!-- Fonts loaded async — never blocks rendering -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload" as="style"
      href="https://fonts.googleapis.com/css2?family=Pacifico&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    </noscript>

    <!-- Smooth SPA-style page transitions -->
    <ViewTransitions />
  </head>
  <body data-dark-hero={darkHero ? 'true' : 'false'}>
    <a href="#main" class="sr-only">Skip to content</a>
    <Header />
    <main id="main" class:list={[{ 'with-offset': !noHeaderOffset }]}>
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />

    <style>
      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      main {
        flex: 1;
      }
      /* Pages without a full-bleed hero get top padding to clear the floating header */
      main.with-offset {
        padding-top: clamp(6rem, 10vw, 8rem);
      }
    </style>

    <script>
      // Reveal-on-scroll using IntersectionObserver.
      // Re-runs after every View Transition navigation so newly swapped-in
      // content animates correctly.
      function initReveal() {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        document
          .querySelectorAll('.reveal:not(.is-visible)')
          .forEach((el) => io.observe(el));
      }
      initReveal();
      document.addEventListener('astro:after-swap', initReveal);
    </script>

    <!-- Netlify Identity — loaded deferred so it never blocks page render -->
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js" defer></script>
    <script>
      // Redirect to admin after login
      window.addEventListener('load', function() {
        if (window.netlifyIdentity) {
          window.netlifyIdentity.on('init', (user) => {
            if (!user) {
              window.netlifyIdentity.on('login', () => {
                document.location.href = '/admin/';
              });
            }
          });
        }
      });
    </script>
  </body>
</html>
