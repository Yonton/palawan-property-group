---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact, company, whatsappLink } from '../data/site';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Palawan Property Group for property inquiries, site viewings, pricing, and the complete buying process in El Nido and across Palawan."
>
  <section class="contact-hero">
    <div class="container">
      <p class="eyebrow">Get in touch</p>
      <h1 class="contact-title">Let's start the conversation</h1>
      <p class="lead">
        Tell us about the property or investment you have in mind. We'll help
        with inquiries, site viewings, pricing, and the complete buying process.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <!-- Contact details -->
      <div class="contact-info">
        <div class="info-block">
          <h2 class="info-heading">Message or call us</h2>
          <p class="info-note">
            WhatsApp and Viber are the fastest way to reach us.
          </p>
          <ul class="info-list">
            {
              contact.phones.map((p) => (
                <li>
                  <a href={whatsappLink(p.e164)} target="_blank" rel="noopener">
                    <span class="info-ic" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                        <path d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21h.004c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01z" />
                      </svg>
                    </span>
                    <span>
                      {p.display}
                      <em>{p.label}</em>
                    </span>
                  </a>
                </li>
              ))
            }
            <li>
              <a href={`mailto:${contact.email}`}>
                <span class="info-ic" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="M3 7l9 6 9-6" />
                  </svg>
                </span>
                <span>{contact.email}</span>
              </a>
            </li>
          </ul>
        </div>

        <div class="info-block">
          <h2 class="info-heading">Office hours</h2>
          <p class="info-hours">{contact.officeHours}</p>
        </div>

        <div class="info-block">
          <h2 class="info-heading">Our team</h2>
          <p class="info-team">{company.broker.name} — {company.broker.title}</p>
          <p class="info-team-sub">{company.broker.license}</p>
          <p class="info-team">
            {company.salesperson.name} — {company.salesperson.title}
          </p>
        </div>
      </div>

      <!-- Contact form -->
      <div class="contact-form-wrap">
        <form id="contactForm" class="contact-form">
          <h2 class="form-title">Send us a message</h2>

          <div class="field">
            <label for="name">Your name</label>
            <input type="text" id="name" name="name" required autocomplete="name" />
          </div>

          <div class="field-row">
            <div class="field">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" required autocomplete="email" />
            </div>
            <div class="field">
              <label for="phone">Phone / WhatsApp</label>
              <input type="tel" id="phone" name="phone" autocomplete="tel" />
            </div>
          </div>

          <div class="field">
            <label for="interest">I'm interested in</label>
            <select id="interest" name="interest">
              <option>Beachfront property</option>
              <option>Residential lot</option>
              <option>Commercial land</option>
              <option>Vacation home</option>
              <option>Investment opportunity</option>
              <option>A specific listing</option>
              <option>Something else</option>
            </select>
          </div>

          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" required></textarea>
          </div>

          <!-- Honeypot: hidden from humans, catches naive bots -->
          <div class="hp-field" aria-hidden="true">
            <label for="company-website">Company website</label>
            <input type="text" id="company-website" name="company-website" tabindex="-1" autocomplete="off" />
          </div>

          <button type="submit" class="btn btn-primary form-submit">
            Send message
          </button>
          <p class="form-fallback">
            Prefer instant chat?
            <a href={whatsappLink(contact.whatsappPrimary)} target="_blank" rel="noopener">
              Message us on WhatsApp
            </a>
          </p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    padding-top: clamp(8rem, 14vw, 11rem);
    padding-bottom: clamp(1.5rem, 4vw, 3rem);
    background: linear-gradient(180deg, var(--c-surface-3), var(--c-surface));
  }
  .contact-title {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    margin-block: 0.6rem 1rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .info-block {
    margin-bottom: 2.2rem;
  }
  .info-heading {
    font-size: 1.2rem;
    margin-bottom: 0.6rem;
    color: var(--c-ink);
  }
  .info-note {
    color: var(--c-muted);
    font-size: 0.92rem;
    margin-bottom: 1rem;
  }
  .info-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .info-list a {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.7rem 0.9rem;
    border-radius: var(--radius);
    background: var(--c-surface-2);
    border: 1px solid var(--c-line);
    color: var(--c-navy);
    font-weight: 600;
    transition: all 0.2s var(--ease);
  }
  .info-list a:hover {
    border-color: var(--c-sky);
    transform: translateX(3px);
  }
  .info-ic {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(19, 181, 234, 0.12);
    color: var(--c-sky-deep);
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .info-list em {
    display: inline-block;
    font-style: normal;
    font-size: 0.72rem;
    color: var(--c-muted);
    font-weight: 500;
    margin-left: 0.4rem;
  }
  .info-hours {
    color: var(--c-body);
  }
  .info-team {
    color: var(--c-body);
    margin-bottom: 0.2rem;
  }
  .info-team-sub {
    font-size: 0.85rem;
    color: var(--c-sky-deep);
    font-weight: 600;
    margin-bottom: 0.8rem;
  }

  /* Form */
  .contact-form {
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    box-shadow: var(--shadow);
  }
  .form-title {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .field {
    margin-bottom: 1.1rem;
  }
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  label {
    display: block;
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--c-navy);
    margin-bottom: 0.4rem;
  }
  input,
  select,
  textarea {
    width: 100%;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--c-ink);
    padding: 0.75rem 0.95rem;
    border: 1.5px solid var(--c-line);
    border-radius: var(--radius);
    background: var(--c-surface-2);
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease);
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--c-sky);
    background: #fff;
  }
  textarea {
    resize: vertical;
  }
  .form-submit {
    width: 100%;
    margin-top: 0.5rem;
  }
  .form-fallback {
    text-align: center;
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--c-muted);
  }
  .form-fallback a {
    color: var(--c-sky-deep);
    font-weight: 600;
    text-decoration: underline;
  }

  /* Honeypot — visually and structurally hidden, but not display:none
     (some bots skip display:none fields) */
  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  @media (max-width: 880px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .field-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline define:vars={{ email: contact.email }}>
  // Static-site friendly: opens the visitor's mail client with a prefilled
  // message. To capture submissions automatically, connect a form service
  // (Formspree, Netlify Forms, Web3Forms) — see the README.
  function initContactForm() {
    const form = document.getElementById('contactForm');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = 'true';
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      // Honeypot: if filled, silently drop (likely a bot)
      if (data.get('company-website')) return;
      const subject = `Property inquiry from ${data.get('name')}`;
      const body = [
        `Name: ${data.get('name')}`,
        `Email: ${data.get('email')}`,
        `Phone: ${data.get('phone') || '—'}`,
        `Interested in: ${data.get('interest')}`,
        '',
        `${data.get('message')}`,
      ].join('\n');
      window.location.href = `mailto:${email}?subject=${encodeURIComponent(
        subject
      )}&body=${encodeURIComponent(body)}`;
    });
  }
  initContactForm();
  document.addEventListener('astro:after-swap', initContactForm);
</script>
