---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';
import BlogCard from '../../components/BlogCard.astro';
import { contact, whatsappLink } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, all: posts },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  all: CollectionEntry<'blog'>[];
}
const { post, all } = Astro.props;
const d = post.data;
const { Content } = await post.render();

const dateLabel = d.pubDate.toLocaleDateString('en-PH', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Rough reading time from the raw markdown body (~200 wpm)
const words = post.body.split(/\s+/).filter(Boolean).length;
const readingMins = Math.max(1, Math.round(words / 200));

// Related: same category first, then fill from the rest, newest first
const related = (() => {
  const others = all.filter((p) => p.slug !== post.slug);
  const same = others.filter((p) => p.data.category === d.category);
  const rest = others.filter((p) => p.data.category !== d.category);
  return [...same, ...rest]
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);
})();

const waHref = whatsappLink(
  contact.whatsappPrimary,
  "Hi! I read your blog and I'd like to know more about property in Palawan."
);
---

<BaseLayout
  title={d.metaTitle ?? d.title}
  description={d.metaDescription ?? d.description}
  image={d.heroImage}
  preloadImage={d.heroImage}
  structuredData="article"
  post={post}
>
  <article class="post">
    <header class="post-head">
      <div class="container post-head-inner">
        <a href="/blog" class="back-link">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M19 12H5M11 18l-6-6 6-6" />
          </svg>
          All articles
        </a>
        <p class="post-cat">{d.category}</p>
        <h1 class="post-title">{d.title}</h1>
        <p class="post-meta">
          <span>{d.author}</span>
          <span aria-hidden="true">•</span>
          <time datetime={d.pubDate.toISOString()}>{dateLabel}</time>
          <span aria-hidden="true">•</span>
          <span>{readingMins} min read</span>
        </p>
      </div>
    </header>

    <div class="container">
      <div class="post-hero">
        <OptimizedImage
          src={d.heroImage}
          alt={d.title}
          width={1280}
          height={720}
          loading="eager"
          fetchpriority="high"
          sizes="(max-width:1100px) 100vw, 1040px"
          class="post-hero-img"
        />
      </div>
    </div>

    <div class="container post-layout">
      <div class="prose">
        <Content />
      </div>

      <div class="post-cta">
        <h2 class="cta-title">Thinking about buying in Palawan?</h2>
        <p class="cta-text">
          We're a locally owned, licensed team based in El Nido. Tell us what
          you're looking for and we'll send matching listings — many never make
          it online.
        </p>
        <div class="cta-actions">
          <a href={waHref} class="btn btn-primary" target="_blank" rel="noopener">
            WhatsApp us
          </a>
          <a href="/listings" class="btn btn-ghost">Browse properties</a>
        </div>
      </div>

      {
        d.tags.length > 0 && (
          <ul class="post-tags" aria-label="Tags">
            {d.tags.map((t) => (
              <li>#{t}</li>
            ))}
          </ul>
        )
      }
    </div>

    {
      related.length > 0 && (
        <section class="section related-section">
          <div class="container">
            <div class="section-head">
              <div>
                <p class="eyebrow reveal">Keep reading</p>
                <h2 class="related-title reveal">More from the blog</h2>
              </div>
              <a href="/blog" class="btn btn-ghost reveal">View all articles</a>
            </div>
            <div class="related-grid">
              {related.map((p) => (
                <BlogCard post={p} />
              ))}
            </div>
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .post-head {
    padding-top: clamp(8rem, 14vw, 10rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.25rem);
    background: linear-gradient(180deg, var(--c-surface-3), var(--c-surface));
  }
  .post-head-inner {
    max-width: 820px;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--c-sky-deep);
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 1.1rem;
    transition: gap 0.2s var(--ease);
  }
  .back-link:hover {
    gap: 0.65rem;
  }
  .post-cat {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-sun);
    margin-bottom: 0.6rem;
  }
  .post-title {
    font-size: clamp(2rem, 4.6vw, 3.1rem);
    margin-bottom: 1rem;
    line-height: 1.12;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    color: var(--c-muted);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .post-hero {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: clamp(2rem, 5vw, 3rem);
    background: var(--c-surface-3);
    box-shadow: var(--shadow);
  }
  .post-hero :global(img.post-hero-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .post-layout {
    max-width: 820px;
  }

  /* ===== PROSE / article body ===== */
  .prose {
    font-size: 1.075rem;
    color: var(--c-body);
    line-height: 1.8;
  }
  .prose :global(h2) {
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--c-ink);
    margin-block: 2.4rem 1rem;
  }
  .prose :global(h3) {
    font-size: clamp(1.2rem, 2.4vw, 1.45rem);
    color: var(--c-ink);
    margin-block: 1.8rem 0.8rem;
  }
  .prose :global(p) {
    margin-bottom: 1.3rem;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.4rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .prose :global(li) {
    padding-left: 0.3rem;
  }
  .prose :global(a) {
    color: var(--c-sky-deep);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose :global(a:hover) {
    color: var(--c-navy);
  }
  .prose :global(strong) {
    color: var(--c-ink);
    font-weight: 700;
  }
  .prose :global(blockquote) {
    margin: 1.8rem 0;
    padding: 0.4rem 0 0.4rem 1.4rem;
    border-left: 4px solid var(--c-sky);
    color: var(--c-navy);
    font-style: italic;
  }
  .prose :global(img) {
    border-radius: var(--radius);
    margin-block: 1.8rem;
  }
  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--c-line);
    margin-block: 2.4rem;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.6rem;
    font-size: 0.97rem;
  }
  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--c-line);
    padding: 0.65rem 0.85rem;
    text-align: left;
  }
  .prose :global(th) {
    background: var(--c-surface-2);
    color: var(--c-ink);
    font-weight: 700;
  }

  /* ===== CTA ===== */
  .post-cta {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding: clamp(1.75rem, 4vw, 2.5rem);
    background: var(--c-sand);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
  }
  .cta-title {
    font-size: clamp(1.4rem, 2.6vw, 1.8rem);
    margin-bottom: 0.6rem;
  }
  .cta-text {
    color: var(--c-body);
    margin-bottom: 1.4rem;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .post-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }
  .post-tags li {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--c-muted);
    background: var(--c-surface-2);
    border: 1px solid var(--c-line);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill);
  }

  /* ===== RELATED ===== */
  .related-section {
    margin-top: clamp(3rem, 7vw, 5rem);
    background: var(--c-surface-2);
  }
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .related-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-bottom: 0;
    margin-top: 0.4rem;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }
  @media (max-width: 980px) {
    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
