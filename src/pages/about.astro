---
import BaseLayout from '../layouts/BaseLayout.astro';
import { company, contact, whatsappLink } from '../data/site';

const waHref = whatsappLink(contact.whatsappPrimary);
---

<BaseLayout
  title="About"
  description="Palawan Property Group is a locally owned real estate company in El Nido, led by a licensed broker and accredited salesperson born and raised in paradise."
>
  <section class="about-hero">
    <div class="container">
      <p class="eyebrow">About us</p>
      <h1 class="about-title">
        Born here. Rooted here.<br />Helping you belong here.
      </h1>
      <p class="lead">
        Palawan Property Group is a professional real estate company based in
        El Nido, founded on a simple belief: the people who know paradise best
        are the ones who call it home.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container story-grid">
      <div class="story-copy">
        <p class="story-para">
          We were born and raised in El Nido, Palawan, and we still live in and
          love this beautiful corner of the world. That isn't a marketing line —
          it shapes everything we do. We know the shorelines, the barangays, the
          tides, and the long-term value behind each opportunity.
        </p>
        <p class="story-para">
          Our passion is helping clients find their perfect property investment
          and own their own slice of paradise. Whether you're looking for
          beachfront property, residential lots, commercial land, vacation
          homes, or investment opportunities, we bring professional service and
          genuine local expertise to help you make the right decision.
        </p>
        <p class="story-para">
          El Nido is recognized as one of the Philippines' top tourist
          destinations — famous for stunning beaches, crystal-clear waters,
          dramatic limestone cliffs, and world-class island hopping. Its
          fast-growing tourism industry also makes it one of the best places for
          real estate investment in the country.
        </p>
      </div>

      <aside class="story-side">
        <div class="team-card">
          <div class="team-avatar" aria-hidden="true">RW</div>
          <div>
            <p class="team-name">{company.broker.name}</p>
            <p class="team-role">{company.broker.title}</p>
            <p class="team-licence">{company.broker.license}</p>
          </div>
        </div>
        <div class="team-card">
          <div class="team-avatar alt" aria-hidden="true">WF</div>
          <div>
            <p class="team-name">{company.salesperson.name}</p>
            <p class="team-role">{company.salesperson.title}</p>
          </div>
        </div>
        <div class="based-card">
          <p class="based-label">Based in</p>
          <p class="based-value">{company.basedIn}</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="values-band">
    <div class="container">
      <div class="vb-grid">
        <div>
          <h3>Local expertise</h3>
          <p>Decades of lived knowledge of El Nido and the wider Palawan market.</p>
        </div>
        <div>
          <h3>Licensed &amp; trusted</h3>
          <p>A PRC-licensed broker and accredited salesperson handling every detail.</p>
        </div>
        <div>
          <h3>End-to-end service</h3>
          <p>Inquiries, viewings, pricing, and the complete buying process.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section about-cta">
    <div class="container about-cta-inner">
      <h2 class="section-title">Let's find your place in paradise.</h2>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-primary">Contact us</a>
        <a href={waHref} class="btn btn-ghost" target="_blank" rel="noopener">
          WhatsApp us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    padding-top: clamp(8rem, 14vw, 11rem);
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
    background: linear-gradient(180deg, var(--c-surface-3), var(--c-surface));
  }
  .about-title {
    font-size: clamp(2.2rem, 5.5vw, 3.8rem);
    margin-block: 0.6rem 1.4rem;
  }

  .story-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .story-para {
    font-size: 1.08rem;
    margin-bottom: 1.4rem;
    color: var(--c-body);
  }
  .story-para:first-child::first-letter {
    font-family: var(--font-display);
    font-size: 3.4rem;
    float: left;
    line-height: 0.8;
    padding: 0.4rem 0.6rem 0 0;
    color: var(--c-sky);
  }

  .story-side {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .team-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--c-surface-2);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
  }
  .team-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
    color: #fff;
    background: linear-gradient(135deg, var(--c-sky), var(--c-sky-deep));
    flex-shrink: 0;
  }
  .team-avatar.alt {
    background: linear-gradient(135deg, var(--c-sun-light), var(--c-sun));
  }
  .team-name {
    font-weight: 700;
    color: var(--c-ink);
  }
  .team-role {
    font-size: 0.9rem;
    color: var(--c-muted);
  }
  .team-licence {
    font-size: 0.82rem;
    color: var(--c-sky-deep);
    font-weight: 600;
    margin-top: 0.15rem;
  }
  .based-card {
    background: var(--c-navy);
    border-radius: var(--radius-lg);
    padding: 1.4rem;
    color: #fff;
  }
  .based-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.6);
  }
  .based-value {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin-top: 0.3rem;
  }

  .values-band {
    background: var(--c-sand);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  .vb-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .vb-grid h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--c-navy);
  }
  .vb-grid p {
    color: var(--c-muted);
    font-size: 0.97rem;
  }

  .about-cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .about-cta-inner .section-title {
    margin: 0;
  }
  .cta-actions {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  @media (max-width: 880px) {
    .story-grid {
      grid-template-columns: 1fr;
    }
    .vb-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
