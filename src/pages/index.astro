---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PropertyCard from '../components/PropertyCard.astro';
import { formatPrice, contact, whatsappLink } from '../data/site';
import HeroBackground from '../components/HeroBackground.astro';
import OptimizedImage from '../components/OptimizedImage.astro';

const all = (await getCollection('listings')).sort(
  (a, b) => a.data.order - b.data.order
);
const featured = all.find((l) => l.data.featured) ?? all[0];
const recent = all.filter((l) => l.id !== featured?.id).slice(0, 3);

const waHref = whatsappLink(
  contact.whatsappPrimary,
  "Hi! I'd like to know more about your properties in Palawan."
);
---

<BaseLayout noHeaderOffset={true} preloadImage={featured?.data.heroImage}>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <HeroBackground />
    <!-- Once you have a real hero photo, layer it on top with low opacity:
    <div class="hero-photo">
      <img src="/images/hero.jpg" alt="" aria-hidden="true" />
    </div> -->

    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="hero-eyebrow">El Nido · Palawan · Philippines</p>
        <h1 class="hero-title">
          Own your slice<br />of <span>paradise.</span>
        </h1>
        <p class="hero-lead">
          Beachfront estates, residential lots, and investment land in one of
          the Philippines' most beautiful destinations — guided by locals who
          know every shoreline.
        </p>
        <div class="hero-actions">
          <a href="/listings" class="btn btn-white">Browse properties</a>
          <a href={waHref} class="btn btn-sun" target="_blank" rel="noopener">
            Talk to us
          </a>
        </div>
      </div>

      {
        featured && (
          <a class="featured-card glass" href={`/listings/${featured.data.slug}`}>
            <span class="featured-flag">
              <span class="dot" /> Featured
            </span>
            <div class="featured-img-wrap">
            <OptimizedImage
              src={featured.data.heroImage}
              alt={featured.data.title}
              width={800}
              height={550}
              loading="eager"
              fetchpriority="high"
              sizes="(max-width:980px) 100vw, 45vw"
              transitionName={`hero-${featured.data.slug}`}
            />
          </div>
            <div class="featured-info">
              <p class="featured-loc">{featured.data.location}</p>
              <h2 class="featured-name">{featured.data.title}</h2>
              <p class="featured-price">
                {formatPrice(
                  featured.data.price,
                  featured.data.priceLabel,
                  featured.data.currency
                )}
              </p>
            </div>
          </a>
        )
      }
    </div>

    <div class="hero-stats container">
      <div class="stat"><strong data-count="20" data-suffix="+">20+</strong><span>Properties</span></div>
      <div class="stat"><strong>Local</strong><span>El Nido experts</span></div>
      <div class="stat"><strong>Licensed</strong><span>PRC accredited</span></div>
      <div class="stat"><strong>End-to-end</strong><span>Buying support</span></div>
    </div>
  </section>

  <!-- ============ VALUE PROPS ============ -->
  <section class="section">
    <div class="container">
      <p class="eyebrow reveal">Why Palawan Property Group</p>
      <h2 class="section-title reveal">
        Born here. Rooted here. Invested in your success.
      </h2>

      <div class="value-grid">
        <div class="value reveal">
          <div class="value-icon">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M12 21s-7-6.5-7-11a7 7 0 0 1 14 0c0 4.5-7 11-7 11z" />
              <circle cx="12" cy="10" r="2.5" />
            </svg>
          </div>
          <h3>Genuine local knowledge</h3>
          <p>
            Born and raised in El Nido, we know which shorelines, lots, and
            barangays hold real long-term value — and which to avoid.
          </p>
        </div>

        <div class="value reveal">
          <div class="value-icon">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M9 12l2 2 4-4" />
              <circle cx="12" cy="12" r="9" />
            </svg>
          </div>
          <h3>Licensed &amp; accredited</h3>
          <p>
            Work with a PRC-licensed broker and accredited salesperson. Every
            title, every document, handled properly and transparently.
          </p>
        </div>

        <div class="value reveal">
          <div class="value-icon">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6" />
            </svg>
          </div>
          <h3>Investment-ready</h3>
          <p>
            From turnkey resorts to raw beachfront, we help you see the upside
            in Palawan's fast-growing tourism economy.
          </p>
        </div>

        <div class="value reveal">
          <div class="value-icon">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
            </svg>
          </div>
          <h3>Here the whole way</h3>
          <p>
            Inquiries, site viewings, pricing, and the complete buying process —
            we stay with you from first message to final signature.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ RECENT LISTINGS ============ -->
  {
    recent.length > 0 && (
      <section class="section listings-section">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="eyebrow reveal">Featured properties</p>
              <h2 class="section-title reveal">Find your place in paradise</h2>
            </div>
            <a href="/listings" class="btn btn-ghost reveal">View all properties</a>
          </div>
          <div class="cards-grid">
            {recent.map((listing) => (
              <PropertyCard listing={listing} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ============ CTA BANNER ============ -->
  <section class="cta-band">
    <div class="container cta-inner">
      <div class="reveal">
        <h2 class="cta-title">Ready to find your slice of paradise?</h2>
        <p class="cta-lead">
          Tell us what you're looking for. We'll match you with the right
          property and walk you through every step.
        </p>
      </div>
      <div class="cta-actions reveal">
        <a href="/contact" class="btn btn-white">Get in touch</a>
        <a href={waHref} class="btn btn-sun" target="_blank" rel="noopener">
          WhatsApp us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function initCounters() {
    const els = document.querySelectorAll<HTMLElement>('strong[data-count]');
    if (!els.length) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    els.forEach((el) => {
      if (el.dataset.counted) return;
      const target = Number(el.dataset.count);
      const suffix = el.dataset.suffix ?? '';
      if (!Number.isFinite(target)) return;

      if (reduce) {
        el.textContent = `${target}${suffix}`;
        el.dataset.counted = 'true';
        return;
      }

      const run = () => {
        el.dataset.counted = 'true';
        const duration = 1100;
        const start = performance.now();
        const tick = (now: number) => {
          const p = Math.min((now - start) / duration, 1);
          // easeOutCubic
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = `${Math.round(target * eased)}${suffix}`;
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              run();
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.4 }
      );
      io.observe(el);
    });
  }
  initCounters();
  document.addEventListener('astro:after-swap', initCounters);
</script>

<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    min-height: clamp(620px, 92vh, 900px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(7rem, 14vh, 11rem) 0;
    overflow: hidden;
  }

  /* hero-photo layer: add once you have a real drone shot */
  .hero-photo {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 3rem;
    flex: 1;
  }

  .hero-eyebrow {
    color: var(--c-sun-light);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: 0.82rem;
    margin-bottom: 1.2rem;
    animation: rise 0.7s var(--ease) 0.1s both;
  }

  .hero-title {
    color: #fff;
    font-size: clamp(2.8rem, 7vw, 5.2rem);
    line-height: 1.02;
    margin-bottom: 1.4rem;
    animation: rise 0.7s var(--ease) 0.2s both;
  }

  .hero-title span {
    font-style: italic;
    color: var(--c-sun-light);
  }

  .hero-lead {
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    max-width: 46ch;
    margin-bottom: 2rem;
    animation: rise 0.7s var(--ease) 0.3s both;
  }

  .hero-actions {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
    animation: rise 0.7s var(--ease) 0.4s both;
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(26px); }
    to { opacity: 1; transform: none; }
  }

  /* Floating featured card (glass) */
  .featured-card {
    border-radius: var(--radius-lg);
    padding: 0.75rem;
    box-shadow: var(--shadow-lg);
    position: relative;
    display: block;
    transition: transform 0.4s var(--ease);
    animation: rise 0.8s var(--ease) 0.5s both;
  }

  .featured-card:hover {
    transform: translateY(-6px);
  }

  .featured-flag {
    position: absolute;
    inset-block-start: 1.4rem;
    inset-inline-start: 1.4rem;
    z-index: 2;
    background: var(--c-sun);
    color: #fff;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-pill);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .featured-flag .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #fff;
    animation: blink 1.6s ease-in-out infinite;
  }

  @keyframes blink {
    50% { opacity: 0.3; }
  }

  .featured-img-wrap {
    width: 100%;
    aspect-ratio: 16 / 11;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .featured-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s var(--ease);
  }
  .featured-card:hover .featured-img-wrap img {
    transform: scale(1.04);
  }

  .featured-info {
    padding: 1rem 0.75rem 0.5rem;
  }

  .featured-loc {
    color: var(--c-sky-deep);
    font-weight: 600;
    font-size: 0.82rem;
    margin-bottom: 0.2rem;
  }

  .featured-name {
    font-size: 1.35rem;
    color: var(--c-ink);
    margin-bottom: 0.4rem;
  }

  .featured-price {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--c-navy);
    font-size: 1.15rem;
  }

  /* Hero stats strip */
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 5vw, 4rem);
    padding-top: clamp(2rem, 5vh, 3.5rem);
    padding-bottom: clamp(2rem, 5vh, 3rem);
    animation: rise 0.8s var(--ease) 0.6s both;
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .stat strong {
    font-family: var(--font-display);
    color: #fff;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 600;
    line-height: 1;
  }

  .stat span {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.85rem;
    margin-top: 0.3rem;
  }

  /* ---------- VALUE PROPS ---------- */
  .value-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .value {
    background: var(--c-surface-2);
    border-radius: var(--radius-lg);
    padding: 2rem 1.6rem;
    border: 1px solid var(--c-line);
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }

  .value:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }

  .value-icon {
    width: 54px;
    height: 54px;
    border-radius: var(--radius);
    background: linear-gradient(135deg, var(--c-sky), var(--c-sky-deep));
    color: #fff;
    display: grid;
    place-items: center;
    margin-bottom: 1.2rem;
  }

  .value h3 {
    font-size: 1.2rem;
    margin-bottom: 0.6rem;
  }

  .value p {
    font-size: 0.93rem;
    color: var(--c-muted);
  }

  /* ---------- LISTINGS SECTION ---------- */
  .listings-section {
    background: var(--c-sand);
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .section-head .section-title {
    margin-bottom: 0;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  /* ---------- CTA BAND ---------- */
  .cta-band {
    background: linear-gradient(120deg, var(--c-navy) 0%, var(--c-sky-deep) 100%);
    position: relative;
    overflow: hidden;
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: clamp(3rem, 6vw, 5rem);
    flex-wrap: wrap;
  }

  .cta-title {
    color: #fff;
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    max-width: 18ch;
    margin-bottom: 0.8rem;
  }

  .cta-lead {
    color: rgba(255, 255, 255, 0.85);
    max-width: 48ch;
  }

  .cta-actions {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 980px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .featured-card {
      max-width: 420px;
    }
    .value-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .value-grid,
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
